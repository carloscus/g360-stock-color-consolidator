# G360 - Stock Color Consolidator
# Copie este archivo como .env y complete sus valores locales
# (NO commitee .env, solo .env.example)

# URL del ERP CIPSA (Source 2 - Playwright)
G360_S2_URL=http://appweb.cipsa.com.pe:9091/

# Credenciales del ERP (usuario y contraseña se ingresan por la app)
# Tambien se pueden definir aqui para uso sin dialog
# G360_S2_USER=tu_usuario
# G360_S2_PASS=tu_contraseña
