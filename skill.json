{
  "name": "cipsa",
  "device": "pc",
  "version": "1.1.0",
  "brand": "cipsa",
  "description": "Stock Color Consolidator - Consolidacion de Stock ERP (CIPSA)",
  "framework": "flet",
  "portable": true,
  "colors": {
    "bg": "#0d1117",
    "surface": "#161b22",
    "accent": "#34d399",
    "text": "#f0f6fc",
    "muted": "#8b949e",
    "success": "#22c55e",
    "warning": "#f59e0b",
    "error": "#ef4444"
  },
  "effects": {
    "glassmorphism": true,
    "blur": "8px",
    "rounded": "10px"
  },
  "signature": {
    "mode": "powered",
    "text": "powered by G360"
  },
  "build": {
    "type": "portable",
    "output": "dist",
    "name": "StockConsolidator-CIPSA",
    "tool": "pyinstaller",
    "onefile": true,
    "windowed": true
  }
}
